# ──────────────────────────────────────────────────────────────
# MẪU BIẾN MÔI TRƯỜNG — sao chép file này thành ".env.local" và điền giá trị.
# KHÔNG commit file .env.local (đã được .gitignore bỏ qua).
# ──────────────────────────────────────────────────────────────

# Google Analytics 4 — phân tích người dùng vào xem.
# Lấy Measurement ID ở: analytics.google.com → Admin → Data Streams.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ──────────────────────────────────────────────────────────────
# VietQR (Sprint 2 — chuyển khoản QR). Thông tin tài khoản nhận tiền
# (không bí mật). Mã BIN ngân hàng tra tại vietqr.io/danh-sach-ngan-hang
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_VIETQR_BANK=970418
NEXT_PUBLIC_VIETQR_BANK_NAME=BIDV
NEXT_PUBLIC_VIETQR_ACCOUNT=2220768712
NEXT_PUBLIC_VIETQR_NAME=TEN CHU TAI KHOAN KHONG DAU

# ──────────────────────────────────────────────────────────────
# VNPay (Sprint 3 — cổng thanh toán). Đăng ký tại sandbox.vnpayment.vn
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_VNPAY_ENABLED=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/thanh-toan/vnpay-return

# ──────────────────────────────────────────────────────────────
# Admin (đăng nhập quản trị). ĐỔI thành giá trị mạnh & bí mật.
# - ADMIN_SECRET: chuỗi ngẫu nhiên dài (tạo: openssl rand -hex 32)
# - Mật khẩu: KHUYẾN NGHỊ dùng ADMIN_PASSWORD_HASH (bcrypt, lưu base64).
#     Tạo hash:  node scripts/hash-password.mjs 'MatKhauManh#2026'
#     (script in ra sẵn dòng ADMIN_PASSWORD_HASH=... dạng base64, dán vào đây)
#   (ADMIN_PASSWORD thô chỉ để chạy thử nhanh — kém an toàn.)
# - 2FA (tùy chọn): chạy  node scripts/setup-2fa.mjs  để lấy ADMIN_TOTP_SECRET
# ──────────────────────────────────────────────────────────────
ADMIN_SECRET=chuoi-ngau-nhien-that-dai-doi-truoc-khi-dung
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=doi-mat-khau-nay
ADMIN_TOTP_SECRET=

# ──────────────────────────────────────────────────────────────
# Supabase (Sprint 2 — cơ sở dữ liệu). Lấy ở app.supabase.com → Settings → API
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────
# Nút chat nổi (Messenger / Zalo / Gọi điện / SMS). Kênh trống = tự ẩn.
# - NEXT_PUBLIC_FB_MESSENGER: username hoặc id Fanpage (vd "trucam" → m.me/trucam),
#   hoặc dán cả link m.me/...
# - NEXT_PUBLIC_ZALO: số điện thoại Zalo hoặc id Zalo OA (→ zalo.me/...), hoặc link đầy đủ
# - NEXT_PUBLIC_PHONE: số hotline (dùng cho nút Gọi điện và Nhắn tin SMS)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PHONE=0900000000
NEXT_PUBLIC_FB_MESSENGER=
NEXT_PUBLIC_ZALO=

# ──────────────────────────────────────────────────────────────
# Email xác nhận đơn (Resend - resend.com). Để trống = không gửi mail.
#   RESEND_API_KEY: lấy ở resend.com → API Keys
#   EMAIL_FROM: địa chỉ gửi (cần xác minh tên miền ở Resend), vd:
#     "Động tiêu Bá Uôn <donhang@tieutrucviet.com.vn>"
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=https://tieutrucviet.com.vn

# ──────────────────────────────────────────────────────────────
# Báo cho CHỦ SHOP khi có đơn mới (kênh nào trống thì tự bỏ qua).
# 1) Email cho chủ shop: nhận mail "🔔 Đơn mới" (cần RESEND_API_KEY ở trên).
OWNER_NOTIFY_EMAIL=
# 2) Telegram — đẩy thông báo về điện thoại tức thì (miễn phí, như Zalo):
#    - Mở Telegram, chat với @BotFather → /newbot → lấy TOKEN.
#    - Nhắn 1 tin cho bot vừa tạo, rồi mở trên trình duyệt:
#        https://api.telegram.org/bot<TOKEN>/getUpdates  → lấy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
